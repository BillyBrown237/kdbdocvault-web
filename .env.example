# API ORIGIN only — never include a path. Version prefixes live in code
# (src/lib/api/http.ts): apiFetch adds /v1, publicApiFetch uses the /pub alias.
#
# Empty/unset = same origin:
#  - dev:  Vite proxies /v1 and /pub -> http://localhost:5057
#  - prod: Caddy serves the SPA and reverse-proxies /v1 + /pub on the same origin
# Only set this if the API lives on another origin (cookies then need SameSite=None).
# VITE_API_URL=
#
# Override for the unversioned public surfaces only if they live elsewhere:
# VITE_PUBLIC_API_URL=

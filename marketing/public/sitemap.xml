<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two URLs, one per language. Each entry declares BOTH versions with
  `xhtml:link` — including itself — which is what the protocol requires and
  what stops the two pages being read as duplicates competing for the same
  content.

  In-page anchors (#pricing, #security…) are not separate URLs and must not be
  listed: a sitemap padded with fragments of the same document is a signal that
  the site is trying to look larger than it is.

  Add a <url> here the day a real second page exists — /verify, /terms,
  /privacy — and remember it needs its French counterpart too.
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
  <url>
    <loc>https://site.kdb.dekoubrown.dev/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://site.kdb.dekoubrown.dev/" />
    <xhtml:link rel="alternate" hreflang="fr" href="https://site.kdb.dekoubrown.dev/fr/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://site.kdb.dekoubrown.dev/" />
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://site.kdb.dekoubrown.dev/fr/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://site.kdb.dekoubrown.dev/" />
    <xhtml:link rel="alternate" hreflang="fr" href="https://site.kdb.dekoubrown.dev/fr/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://site.kdb.dekoubrown.dev/" />
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
